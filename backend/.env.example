# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# YouCam (Perfect Corp) API Key & Settings
YOUCAM_API_KEY=your_youcam_api_key_here
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# Seconds to keep polling a YouCam task before falling back to the simulator
YOUCAM_POLL_TIMEOUT=90
# Bangs style -> YouCam hair-bang template ID (list them with: python scripts/youcam_smoke.py --bang-templates)
YOUCAM_BANG_TEMPLATES={"see_through": "", "curtain": "", "full_straight": ""}
# If set to true, uses the built-in Mock Simulator for offline testing or without API credits
USE_MOCK_YOUCAM=false

# Server Settings
HOST=127.0.0.1
PORT=8000
# Comma-separated origins allowed to call the API cross-origin (dev only; production serves the SPA same-origin)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
